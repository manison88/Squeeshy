<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Friends & trading: the shelf zone and its shares live in this
	     container. CKContainer.default() resolves to the first entry. -->
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<!-- CloudKit subscriptions deliver silent pushes. Xcode switches this to
	     production when archiving for the App Store. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
